# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- App ---
APP_NAME=EventLoop API
ENVIRONMENT=development

# --- Frontend origin (for CORS) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- MongoDB Atlas (added in the next step) ---
MONGODB_URI=
MONGODB_DB=eventloop

# --- AI APIs (added later) ---
JINA_API_KEY=
GROQ_API_KEY=

# --- Supabase (auth) ---
# Project URL from the dashboard.
SUPABASE_URL=
# Legacy HS256 secret — dashboard → Project Settings → JWT Keys → Legacy JWT Secret.
# Only needed if your project still issues HS256-signed tokens. New projects
# with asymmetric JWT signing keys can leave this blank.
SUPABASE_JWT_SECRET=
# Service role key — dashboard → Project Settings → API Keys → "Secret key".
# Backend-only. Required for account deletion. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
