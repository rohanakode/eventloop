# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Supabase (auth) ---
# Dashboard → project home → the URL under your project name.
VITE_SUPABASE_URL=

# Dashboard → Project Settings → API Keys → "Publishable key"
# (this is what used to be called the "anon public" key — safe to ship in the frontend).
VITE_SUPABASE_ANON_KEY=
